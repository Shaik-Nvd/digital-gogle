# Chat model + speech-to-text (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Fish Audio text-to-speech
# API key:  https://fish.audio/app/api-keys/
# Voice ID: open a voice at https://fish.audio and copy the id from the URL
#           https://fish.audio/m/<FISH_AUDIO_VOICE_ID>
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_VOICE_ID=your_fish_audio_reference_id_here
# Voice for Hindi and other Indian-script replies (English text keeps using FISH_AUDIO_VOICE_ID above).
# Verified: Hindi, Marathi, Bengali, Gujarati, Tamil, Telugu, Urdu. Leave empty to keep Indian-script replies silent.
FISH_AUDIO_VOICE_ID_HI=your_indian_language_voice_reference_id_here
# s2.1-pro-free is free for developers (Fish lists it through 2026-11-30); s2.1-pro is the paid model.
FISH_AUDIO_MODEL=s2.1-pro-free

# Where chat leads are delivered. Any endpoint that accepts a JSON POST.
# For email delivery, create a form at https://formspree.io and paste its
# endpoint here: https://formspree.io/f/xxxxxxxx
# Leave unset to disable lead capture (the route no-ops instead of erroring).
LEAD_WEBHOOK_URL=
